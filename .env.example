# 运行所需环境变量，复制为 .env 后填入真实值（.env 不入库）
# 模型接入（voyoagent / Yo_Agent 使用）
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_AUTH_TOKEN=
# PG 连接串（server 持久化）
DATABASE_URL=postgresql://user:pass@host:5432/db
# 可选：PG 连接池
PG_POOL_MIN_SIZE=
PG_POOL_MAX_SIZE=
# 可选：日志目录（默认 logs）
LOG_DIR=
# 可选：技能物化目录（默认 runtime/skills）
SKILL_WORK_DIR=
